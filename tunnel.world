<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tunnel_world">
    <scene>
      <ambient>0.25 0.25 0.3 1.0</ambient>
      <background>0.04 0.05 0.08 1.0</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ================================================================= -->
    <!-- 🚁 HARİTALAMA DRONU (QUADCOPTER + KAMERA + LAZER + FENER)          -->
    <!-- ================================================================= -->
    <model name="mapping_drone">
      <pose>0.0 0.0 0.4 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.034</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.034</iyy><iyz>0</iyz>
            <izz>0.06</izz>
          </inertia>
        </inertial>

        <!-- Dron Ana Gövdesi (Karbon Fiber) -->
        <collision name="body_collision">
          <geometry><box><size>0.40 0.40 0.12</size></box></geometry>
        </collision>
        <visual name="body_visual">
          <geometry><box><size>0.40 0.40 0.12</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.18 1</ambient>
            <diffuse>0.2 0.2 0.25 1</diffuse>
          </material>
        </visual>

        <!-- 4 Adet Pervane ve Motor -->
        <!-- Ön Sol Motor -->
        <visual name="prop_fl">
          <pose>0.18 0.18 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.015</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.1 1</ambient><diffuse>0.9 0.2 0.1 1</diffuse></material>
        </visual>
        <!-- Ön Sağ Motor -->
        <visual name="prop_fr">
          <pose>0.18 -0.18 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.015</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.1 1</ambient><diffuse>0.9 0.2 0.1 1</diffuse></material>
        </visual>
        <!-- Arka Sol Motor -->
        <visual name="prop_rl">
          <pose>-0.18 0.18 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.015</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <!-- Arka Sağ Motor -->
        <visual name="prop_rr">
          <pose>-0.18 -0.18 0.08 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>0.015</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>

        <!-- 📷 ÖN HARİTALAMA KAMERASI (1080p / 90° FOV) -->
        <sensor name="camera_front" type="camera">
          <pose>0.22 0.0 0.02 0 0 0</pose>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.05</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
        </sensor>

        <!-- 📏 ZEMİNE BAKAN TFMINI LAZER İRTİFA SENSÖRÜ -->
        <sensor name="laser_altitude" type="ray">
          <pose>0.0 0.0 -0.05 0 1.5708 0</pose>
          <ray>
            <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
            <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
          </ray>
          <always_on>1</always_on>
          <update_rate>50</update_rate>
          <visualize>true</visualize>
        </sensor>

        <!-- 💡 DRON ÖNÜNDEKİ GÜÇLÜ AYDINLATMA FENERİ (Spotlight) -->
        <light name="drone_spotlight" type="spot">
          <pose>0.25 0.0 0.0 0 0 0</pose>
          <diffuse>1.0 0.98 0.95 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
          <attenuation><range>25</range><constant>0.2</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
          <spot><inner_angle>0.6</inner_angle><outer_angle>1.1</outer_angle><falloff>1.0</falloff></spot>
          <direction>1 0 0</direction>
        </light>

      </link>
    </model>

    <!-- TUNEL SOL DUVAR -->

    <model name="tunnel_wall_left">
      <static>true</static>
      <pose>5.0 2.2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30.0 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.0 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.55 0.57 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- TUNEL SAG DUVAR -->
    <model name="tunnel_wall_right">
      <static>true</static>
      <pose>5.0 -2.2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30.0 0.3 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.0 0.3 3.0</size></box></geometry>
          <material>
            <ambient>0.45 0.47 0.50 1</ambient>
            <diffuse>0.55 0.57 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- TUNEL TAVANI -->
    <model name="tunnel_ceiling">
      <static>true</static>
      <pose>5.0 0.0 3.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30.0 4.7 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30.0 4.7 0.3</size></box></geometry>
          <material>
            <ambient>0.35 0.37 0.40 1</ambient>
            <diffuse>0.45 0.47 0.50 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- DARBOGAZ ENGEL 1 -->
    <model name="bottleneck_pillar_1">
      <static>true</static>
      <pose>4.0 1.1 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.45</radius><length>2.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.45</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.25 0.2 1</ambient>
            <diffuse>0.85 0.30 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- DARBOGAZ ENGEL 2 -->
    <model name="bottleneck_pillar_2">
      <static>true</static>
      <pose>10.0 -1.0 1.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.50</radius><length>2.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.50</radius><length>2.4</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.25 0.2 1</ambient>
            <diffuse>0.85 0.30 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
