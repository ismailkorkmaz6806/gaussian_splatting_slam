<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="dark_tunnel_world">
    <physics name="1ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sistem Eklentileri -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 🌌 Karanlık Yeraltı / Tünel Atmosferi -->
    <scene>
      <ambient>0.12 0.12 0.15 1.0</ambient>
      <background>0.05 0.05 0.08 1.0</background>
      <grid>false</grid>
    </scene>

    <!-- Zemin (Beton / Taş Zemin) -->
    <model name="tunnel_floor">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><box><size>60 8 0.2</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>60 8 0.2</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>20 0 0 0 0 0</pose>
    </model>

    <!-- 🏠 Tünel Tavanı (Tamamen Kapalı) -->
    <model name="tunnel_ceiling">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><box><size>60 8 0.2</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>60 8 0.2</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.18 1</ambient>
            <diffuse>0.18 0.18 0.22 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>20 0 4.0 0 0 0</pose>
    </model>

    <!-- Sol Duvar -->
    <model name="tunnel_wall_left">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><box><size>60 0.4 4.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>60 0.4 4.0</size></box></geometry>
          <material>
            <ambient>0.25 0.22 0.20 1</ambient>
            <diffuse>0.35 0.30 0.28 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>20 -3.8 2.0 0 0 0</pose>
    </model>

    <!-- Sağ Duvar -->
    <model name="tunnel_wall_right">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><box><size>60 0.4 4.0</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>60 0.4 4.0</size></box></geometry>
          <material>
            <ambient>0.25 0.22 0.20 1</ambient>
            <diffuse>0.35 0.30 0.28 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>20 3.8 2.0 0 0 0</pose>
    </model>

    <!-- Tünel İçi Destek Kemerleri & Kolonlar -->
    <model name="arch_1">
      <static>true</static>
      <pose>8 0 2.0 0 0 0</pose>
      <link name="pillar_l"><visual name="v"><geometry><box><size>0.6 0.6 4.0</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 -3.4 0 0 0 0</pose></link>
      <link name="pillar_r"><visual name="v"><geometry><box><size>0.6 0.6 4.0</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 3.4 0 0 0 0</pose></link>
      <link name="beam"><visual name="v"><geometry><box><size>0.6 7.4 0.6</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 0 1.7 0 0 0</pose></link>
    </model>

    <model name="arch_2">
      <static>true</static>
      <pose>18 0 2.0 0 0 0</pose>
      <link name="pillar_l"><visual name="v"><geometry><box><size>0.6 0.6 4.0</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 -3.4 0 0 0 0</pose></link>
      <link name="pillar_r"><visual name="v"><geometry><box><size>0.6 0.6 4.0</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 3.4 0 0 0 0</pose></link>
      <link name="beam"><visual name="v"><geometry><box><size>0.6 7.4 0.6</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 0 1.7 0 0 0</pose></link>
    </model>

    <model name="arch_3">
      <static>true</static>
      <pose>28 0 2.0 0 0 0</pose>
      <link name="pillar_l"><visual name="v"><geometry><box><size>0.6 0.6 4.0</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 -3.4 0 0 0 0</pose></link>
      <link name="pillar_r"><visual name="v"><geometry><box><size>0.6 0.6 4.0</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 3.4 0 0 0 0</pose></link>
      <link name="beam"><visual name="v"><geometry><box><size>0.6 7.4 0.6</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual><pose>0 0 1.7 0 0 0</pose></link>
    </model>

    <!-- Tünel İçi Engeller (Kaya Blokları & Sandıklar) -->
    <model name="rock_obstacle1">
      <static>true</static>
      <pose>12 -1.2 0.7 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 1.4 1.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 1.4 1.4</size></box></geometry><material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rock_obstacle2">
      <static>true</static>
      <pose>22 1.4 0.9 0 0 -0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 1.5 1.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 1.5 1.8</size></box></geometry><material><ambient>0.3 0.4 0.5 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 🚁 3B Quadcopter Dron ve Otonom Uçuş Sistemi -->
    <model name="tunnel_quadcopter">
      <pose>0 0 1.3 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.04</izz></inertia>
        </inertial>

        <!-- Dron Gövdesi -->
        <visual name="body">
          <geometry><box><size>0.4 0.4 0.1</size></box></geometry>
          <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
        </visual>
        <collision name="c">
          <geometry><box><size>0.4 0.4 0.1</size></box></geometry>
        </collision>

        <!-- 4 Adet Pervane Kolu -->
        <visual name="arm1"><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry><pose>0 0 0 0 1.57 0.785</pose><material><ambient>0.8 0.1 0.1 1</ambient></material></visual>
        <visual name="arm2"><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry><pose>0 0 0 0 1.57 -0.785</pose><material><ambient>0.1 0.3 0.8 1</ambient></material></visual>

        <!-- 💡 Dronun Güçlü Ön Feneri (Karanlık Tüneli Aydınlatan Işık) -->
        <light type="spot" name="drone_headlight">
          <pose>0.25 0 0.05 0 0.1 0</pose>
          <diffuse>1.0 1.0 0.9 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
          <attenuation><range>25</range><constant>0.2</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
          <spot><inner_angle>0.6</inner_angle><outer_angle>1.1</outer_angle><falloff>0.8</falloff></spot>
          <direction>1 0 -0.1</direction>
          <cast_shadows>true</cast_shadows>
        </light>

        <!-- 📹 Dron HD Ön Kamerası -->
        <sensor name="camera" type="camera">
          <pose>0.25 0 0.05 0 0.05 0</pose>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image><width>800</width><height>600</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>60</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
        </sensor>
      </link>

      <!-- 🚀 Otonom Tünel İlerleme Eklentisi (Dron tünelde süzülerek uçar) -->
      <plugin
        filename="gz-sim-trajectory-follower-system"
        name="gz::sim::systems::TrajectoryFollower">
        <link_name>base_link</link_name>
        <waypoints>
          <waypoint><time>0</time><pose>0 0 1.3 0 0 0</pose></waypoint>
          <waypoint><time>5</time><pose>8 0.5 1.4 0 0 0.05</pose></waypoint>
          <waypoint><time>10</time><pose>15 -0.6 1.3 0 0 -0.08</pose></waypoint>
          <waypoint><time>15</time><pose>24 0.4 1.5 0 0 0.04</pose></waypoint>
          <waypoint><time>20</time><pose>32 0 1.3 0 0 0</pose></waypoint>
          <waypoint><time>25</time><pose>38 0 1.3 0 0 3.14</pose></waypoint>
          <waypoint><time>32</time><pose>20 0 1.3 0 0 3.14</pose></waypoint>
          <waypoint><time>40</time><pose>0 0 1.3 0 0 0</pose></waypoint>
        </waypoints>
        <loop>true</loop>
      </plugin>
    </model>
  </world>
</sdf>
