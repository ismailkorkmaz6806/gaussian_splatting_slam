    <!-- 🚁 DARPA Mağara Keşif Dronu (Ana Koridor Ortası - 2.0m İrtifa, Ufka Paralel) -->
    <model name="cave_drone">
      <pose>3.33 -10.0 2.0 0 0 1.5708</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz></inertia>
        </inertial>

        <!-- Dron Govdesi -->
        <visual name="body">
          <geometry><box><size>0.4 0.4 0.12</size></box></geometry>
          <material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>0.4 0.4 0.12</size></box></geometry>
        </collision>

        <!-- Pervane Kollari -->
        <visual name="arm1"><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry><pose>0 0 0 0 1.57 0.785</pose><material><ambient>0.9 0.1 0.1 1</ambient></material></visual>
        <visual name="arm2"><geometry><cylinder><radius>0.02</radius><length>0.5</length></cylinder></geometry><pose>0 0 0 0 1.57 -0.785</pose><material><ambient>0.1 0.4 0.9 1</ambient></material></visual>

        <!-- 💡 Yumuşak & Titreşimsiz Keşif Feneri (Patlama Önleyici Dinamik Aralık) -->
        <light type="spot" name="drone_headlight">
          <pose>0.25 0 0.05 0 0 0</pose>
          <diffuse>0.38 0.38 0.40 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <attenuation>
            <range>35</range>
            <constant>0.80</constant>
            <linear>0.04</linear>
            <quadratic>0.005</quadratic>
          </attenuation>
          <spot>
            <inner_angle>1.10</inner_angle>
            <outer_angle>1.60</outer_angle>
            <falloff>0.45</falloff>
          </spot>
          <direction>1 0 0</direction>
          <cast_shadows>false</cast_shadows>
        </light>

        <!-- 📹 HD On Kamera (Ufka Paralel - 150m Derinlik Görüşü) -->
        <sensor name="camera" type="camera">
          <pose>0.25 0 0.05 0 0 0</pose>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image><width>800</width><height>600</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>150.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
        </sensor>
      </link>

      <!-- 🎮 Hiz Kontrol Eklentisi (/cmd_vel) -->
      <plugin
        filename="gz-sim-velocity-control-system"
        name="gz::sim::systems::VelocityControl">
        <initial_linear>0 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
        <topic>/cmd_vel</topic>
      </plugin>

      <!-- 📍 Odometri Yayini (/model/cave_drone/odometry) -->
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/model/cave_drone/odometry</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
