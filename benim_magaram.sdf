<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="benim_magaram">
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.78 0.78 0.80 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>false</shadows>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 🎥 Gazebo Başlangıç Kamerası: Dronun arkasında, doğrudan tünelin içine bakar -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-6.5 0.0 1.2 0 0.05 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Dış Güneş Işığı: Giriş ağzına ve dış alana doğal güneş -->
    <light name="dis_gunes" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>-15 0 25 0 0 0</pose>
      <diffuse>0.90 0.88 0.85 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.6 0.15 -0.6</direction>
    </light>

    <!-- Mağara İçi Aydınlatma: Hem zemini hem duvarları net aydınlatan açılı dolgu ışığı -->
    <light name="magara_ici_isik" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>20 0 15 0 0 0</pose>
      <diffuse>0.75 0.73 0.70 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 0.2 -0.8</direction>
    </light>

    <!-- 1. DIŞ PİST ZEMİNİ (Z=-0.01 ile tünel zemininden çakışmasız) -->
    <model name="dis_zemin">
      <static>true</static>
      <pose>20 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>90 90</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>90 90</size></plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.68 0.68 0.68 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>model://organic_cave/meshes/tarmac.png</albedo_map>
                <roughness>0.85</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. DOĞAL KAYA TÜNELİ (TAVAN + DUVARLAR + TAŞ DESENLİ ZEMİN DAHİL) -->
    <model name="uzun_kaya_tuneli">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <mesh>
              <scale>1.0 1.0 1.0</scale>
              <uri>model://organic_cave/meshes/organic_cave.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <scale>1.0 1.0 1.0</scale>
              <uri>model://organic_cave/meshes/organic_cave.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ============================================================ -->
    <!-- MAĞARA İÇİ KAYALAR VE İNSANLAR (X > 5m)                       -->
    <!-- ============================================================ -->
    <model name="ic_kaya_1">
      <static>true</static>
      <pose>8.0 -2.2 0 0 0 -0.5</pose>
      <link name="l">
        <visual name="v"><geometry><mesh><scale>0.8 0.8 0.7</scale><uri>model://rock_2/meshes/model.dae</uri></mesh></geometry></visual>
      </link>
    </model>

    <model name="ic_insan_1">
      <static>true</static>
      <pose>12.0 1.8 0 0 0 1.4</pose>
      <link name="l">
        <pose>0 0 -0.623996 0 0 0</pose>
        <visual name="v"><geometry><mesh><scale>1 1 1</scale><uri>model://survivor/meshes/rescue_randy.dae</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="ic_kutu_1">
      <static>true</static>
      <pose>12.8 1.8 0.15 0 0 0.2</pose>
      <link name="l"><visual name="v"><geometry><mesh><uri>model://grey_tote/meshes/tote.dae</uri></mesh></geometry></visual></link>
    </model>

    <model name="ic_kaya_2">
      <static>true</static>
      <pose>18.0 2.5 0 0 0 1.0</pose>
      <link name="l">
        <visual name="v"><geometry><mesh><scale>0.85 0.85 0.75</scale><uri>model://rock_3/meshes/model.dae</uri></mesh></geometry></visual>
      </link>
    </model>

    <model name="ic_kutu_2">
      <static>true</static>
      <pose>22.0 -1.5 0.15 0 0 -0.3</pose>
      <link name="l"><visual name="v"><geometry><mesh><uri>model://grey_tote/meshes/tote.dae</uri></mesh></geometry></visual></link>
    </model>
    <model name="ic_canta_1">
      <static>true</static>
      <pose>22.6 -1.5 0 0 0 0.8</pose>
      <link name="l"><visual name="v"><geometry><mesh><uri>model://backpack/meshes/backpack.dae</uri></mesh></geometry></visual></link>
    </model>

    <model name="ic_kaya_3">
      <static>true</static>
      <pose>28.0 -2.2 0 0 0 -0.7</pose>
      <link name="l">
        <visual name="v"><geometry><mesh><scale>0.9 0.9 0.8</scale><uri>model://rock_4/meshes/model.dae</uri></mesh></geometry></visual>
      </link>
    </model>

    <model name="ic_insan_2">
      <static>true</static>
      <pose>33.0 1.2 0 0 0 -0.9</pose>
      <link name="l">
        <pose>0 0 -0.623996 0 0 0</pose>
        <visual name="v"><geometry><mesh><scale>1 1 1</scale><uri>model://survivor/meshes/rescue_randy.dae</uri></mesh></geometry></visual>
      </link>
    </model>
    <model name="ic_kutu_3">
      <static>true</static>
      <pose>33.8 1.0 0.15 0 0 0.4</pose>
      <link name="l"><visual name="v"><geometry><mesh><uri>model://grey_tote/meshes/tote.dae</uri></mesh></geometry></visual></link>
    </model>

  </world>
</sdf>
