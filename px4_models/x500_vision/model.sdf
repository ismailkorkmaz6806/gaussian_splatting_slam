<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_vision'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://mono_cam</uri>
      <pose>.12 .03 .242 0 0 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">.12 .03 .242 0 0 0</pose>
    </joint>
    <!-- Aşağı Bakan Lazer Mesafe Lidar Sensörü (LW20 Rangefinder) -->
    <include merge='true'>
      <uri>model://LW20</uri>
      <pose relative_to="base_link">0 0 -0.079 0 1.57 0</pose>
    </include>
    <joint name="lidar_model_joint" type="fixed">
      <parent>base_link</parent>
      <child>lw20_link</child>
      <pose relative_to="base_link">-0 0 0 0 0 0</pose>
    </joint>
    <joint name="lidar_sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_sensor_link</child>
    </joint>
    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name='lidar' type='gpu_lidar'>
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 3.14 0 0</pose>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>50.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- 🔦 Dron Ön Arama ve Keşif Projektörü (Drone Spotlight) -->
    <link name="drone_spotlight_link">
      <pose relative_to="base_link">0.2 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="spotlight_bulb">
        <geometry>
          <sphere><radius>0.02</radius></sphere>
        </geometry>
        <material>
          <ambient>1 1 0.9 1</ambient>
          <diffuse>1 1 0.9 1</diffuse>
          <emissive>1 1 0.9 1</emissive>
        </material>
      </visual>
      <light name="drone_spotlight" type="spot">
        <cast_shadows>0</cast_shadows>
        <pose>0 0 0 0 0 0</pose>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
        <attenuation>
          <range>25</range>
          <constant>0.2</constant>
          <linear>0.05</linear>
          <quadratic>0.005</quadratic>
        </attenuation>
        <spot>
          <inner_angle>0.6</inner_angle>
          <outer_angle>1.2</outer_angle>
          <falloff>1.0</falloff>
        </spot>
        <direction>1 0 -0.15</direction>
      </light>
    </link>
    <joint name="spotlight_joint" type="fixed">
      <parent>base_link</parent>
      <child>drone_spotlight_link</child>
    </joint>

    

    
    

    
    <!-- 📡 Dron Tepe 360 Derece 3D Lidar Sensörü -->
    <link name="forward_lidar_link">
      <pose relative_to="base_link">0 0 0.075 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="top_lidar_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.035</length></cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.25 0.25 0.25 1</diffuse>
        </material>
      </visual>
      <visual name="lidar_mount_stand">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.008</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name='forward_lidar' type='gpu_lidar'>
        <gz_frame_id>forward_lidar_link</gz_frame_id>
        <pose>0 0 0.02 0 0 0</pose>
        <update_rate>15</update_rate>
        <topic>/forward_lidar</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>25.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.02</stddev>
          </noise>
        </ray>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="forward_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>forward_lidar_link</child>
    </joint>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
